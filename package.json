{
  "name": "lee-spec-kit",
  "version": "0.7.8",
  "description": "Agent-guided development harness CLI for spec-driven projects",
  "type": "module",
  "bin": {
    "lee-spec-kit": "./dist/index.js",
    "lsk": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "templates",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:test": "eslint tests",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.tests.json --noEmit",
    "test": "pnpm build && vitest run",
    "test:race": "pnpm build && vitest run tests/race.test.mjs",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "docs",
    "template",
    "cli",
    "ai",
    "agent",
    "specification",
    "documentation",
    "harness",
    "orchestration",
    "workflow"
  ],
  "author": "Lee Yoonsu",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leey00nsu/lee-spec-kit"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "fs-extra": "^11.3.3",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.3",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.7.0"
}
